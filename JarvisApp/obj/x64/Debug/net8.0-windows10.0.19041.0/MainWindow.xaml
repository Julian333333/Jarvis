<Window
    x:Class="JarvisApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource SystemAccentColor}" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="White"/>
                <TextBlock Text="JARVIS AI Assistant" 
                          Style="{StaticResource TitleTextBlockStyle}"
                          Foreground="White"
                          VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:ConnectionId='26' x:Name="MinimizeButton" 
                        Content="&#xE921;" 
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        Foreground="White"
                                                    
                        Width="40" Height="32"/>
                <Button x:ConnectionId='27' x:Name="SettingsButton" 
                        Content="&#xE713;" 
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        Foreground="White"
                                                    
                        Width="40" Height="32"/>
            </StackPanel>
        </Grid>

        <!-- Main Content - Responsive Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:ConnectionId='6' Width="350" x:Name="SidebarColumn"/>
            </Grid.ColumnDefinitions>

            <!-- Main Chat Area -->
            <Grid Grid.Column="0" Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Welcome Card -->
                <Border Grid.Row="0"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="20"
                       Margin="0,0,0,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Welcome to JARVIS" 
                                  Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Your intelligent AI assistant for Windows 11" 
                                  Style="{StaticResource BodyTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Chat History / Response Area -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                              Text="Conversation" 
                              Style="{StaticResource BodyStrongTextBlockStyle}"
                              Margin="0,0,0,8"/>
                    
                    <Border Grid.Row="1"
                           Background="{ThemeResource LayerFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16">
                        <ScrollViewer x:ConnectionId='23' x:Name="ChatScrollViewer"
                                     VerticalScrollBarVisibility="Auto">
                            <StackPanel x:ConnectionId='24' x:Name="ChatMessagesPanel" Spacing="12">
                                <TextBlock x:ConnectionId='25' x:Name="ResponseTextBlock"
                                          Text="Bereit für deine Fragen..."
                                          Style="{StaticResource BodyTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Input Area -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:ConnectionId='20' x:Name="InputTextBox"
                             Grid.Column="0"
                             PlaceholderText="Type your message or command..."
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="12"
                                                           />

                    <StackPanel Grid.Column="1" 
                               Orientation="Vertical" 
                               Spacing="8" 
                               Margin="12,0,0,0">
                        <Button x:ConnectionId='21' x:Name="SendButton"
                               Content="&#xE724;" 
                               FontFamily="Segoe MDL2 Assets"
                               ToolTipService.ToolTip="Send (Ctrl+Enter)"
                               Style="{StaticResource AccentButtonStyle}"
                                                       
                               Width="80"
                               Height="36"/>
                        
                        <Button x:ConnectionId='22' x:Name="ClearButton"
                               Content="&#xE74D;"
                               FontFamily="Segoe MDL2 Assets"
                               ToolTipService.ToolTip="Clear chat"
                                                        
                               Width="80"
                               Height="36"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <Border Grid.Column="1" 
                    Width="1" 
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Margin="0,20"/>

            <!-- Sidebar - Controls & Status -->
            <ScrollViewer Grid.Column="2" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="20">
                <StackPanel Spacing="16">

                    <!-- Voice Control Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🎙️ Voice Control" 
                                      Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            
                            <ToggleSwitch x:ConnectionId='18' x:Name="VoiceToggle"
                                         Header="Speech Recognition"
                                         OffContent="Off"
                                         OnContent="Active"
                                                                      />
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hotword: 'Jarvis'" 
                                          Style="{StaticResource CaptionTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:ConnectionId='19' x:Name="VoiceStatusTextBlock"
                                          Text="🎙️ Voice disabled"
                                          Style="{StaticResource CaptionTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Autonomy Control Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🤖 Autonomous Mode" 
                                      Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <ComboBox x:ConnectionId='10' x:Name="AutonomyModeCombo"
                                      Header="Mode"
                                      HorizontalAlignment="Stretch"
                                                                                           >
                                <ComboBoxItem Content="Disabled" Tag="Off" IsSelected="True"/>
                                <ComboBoxItem Content="Paused" Tag="Paused"/>
                                <ComboBoxItem Content="Full Autonomy" Tag="Full"/>
                            </ComboBox>

                            <TextBlock x:ConnectionId='11' x:Name="AutonomyStateTextBlock"
                                       Text="Autonomy disabled"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <TextBox x:ConnectionId='12' x:Name="AutonomyGoalTextBox"
                                     PlaceholderText="Describe a goal for Jarvis..."
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     Height="60"
                                                                          />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='15' Content="Add"
                                        x:Name="AutonomyAddGoalButton"
                                                                           
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                                <Button x:ConnectionId='16' Content="Pause"
                                        x:Name="AutonomyPauseButton"
                                                                         
                                        HorizontalAlignment="Stretch"/>
                                <Button x:ConnectionId='17' Content="Stop"
                                        x:Name="AutonomyStopButton"
                                                                        
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Expander Header="Active Goals" IsExpanded="False">
                                <ListView x:ConnectionId='14' x:Name="AutonomyGoalsList"
                                          MaxHeight="120"
                                          SelectionMode="None"
                                          IsHitTestVisible="False"/>
                            </Expander>

                            <Expander Header="Action Log" IsExpanded="False">
                                <ListView x:ConnectionId='13' x:Name="AutonomyLogList"
                                          MaxHeight="150"
                                          SelectionMode="None"
                                          IsHitTestVisible="False"/>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⚡ Quick Actions" 
                                      Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            
                            <Button x:ConnectionId='7' x:Name="WorkModeButton"
                                   Content="🎵 Work Mode"
                                   HorizontalAlignment="Stretch"
                                                               />
                            
                            <Button x:ConnectionId='8' x:Name="VisionButton"
                                   Content="👁️ Screen Capture"
                                   HorizontalAlignment="Stretch"
                                                             />
                            
                            <Button x:ConnectionId='9' x:Name="WebSearchButton"
                                   Content="🌐 Web Search"
                                   HorizontalAlignment="Stretch"
                                                                />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" 
              Background="{ThemeResource LayerFillColorAltBrush}"
              Padding="16,8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" VerticalAlignment="Center">
                <ProgressRing x:ConnectionId='3' x:Name="StatusProgressRing" 
                             Width="16" 
                             Height="16" 
                             IsActive="False"
                             Visibility="Collapsed"/>
                <FontIcon x:ConnectionId='4' x:Name="StatusIcon" 
                         Glyph="&#xE73E;" 
                         FontSize="16"
                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock x:ConnectionId='5' x:Name="StatusTextBlock" 
                          Text="Ready" 
                          Style="{StaticResource CaptionTextBlockStyle}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" 
                       Orientation="Horizontal" 
                       Spacing="12"
                       VerticalAlignment="Center">
                <TextBlock x:ConnectionId='2' x:Name="ModelStatusTextBlock"
                          Text="AI: Not Connected"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="WinUI 3 • .NET 8" 
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

